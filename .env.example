POSTGRES_USER=monaa
# Required. start.sh / start.cmd fill in a random password when they create .env
POSTGRES_PASSWORD=
POSTGRES_DB=monaa_lisa_db
# Only needed when running the backend or Python code outside of docker compose
# DATABASE_URL=postgresql://monaa:<password>@localhost:5432/monaa_lisa_db
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:3000
SEMANTIC_SCHOLAR_API_KEY=
# Requests per minute per client IP for the backend API
RATE_LIMIT_PER_MINUTE=300
# Number of reverse proxies in front of the backend (e.g. 1 behind Caddy), empty when none
TRUST_PROXY=
